      ]
    },
    {
      "claim_id": "sql_no_prefix/Q1.5/003",
      "text": "| **Capillary tube (Ostwald / Ubbelohde)** | ~38 |",
      "line": 34,
      "category": "database_verified",
      "incorrect": false,
      "reason": "Approximate study counts agree with 38,25,3;~26 adequately approximates 25 papers/26 blocks.",
      "evidence": [
        "N:\\_Code_Maintenance\\ThermoML_research_agent\\ThermoML.v2020-09-30.db\\thermoml_raw.db",
        "evidence/reference_findings.md; standard-method pure-ethanol counts: capillary38/38,sphere26/25,concentric3/3 blocks/papers"
      ]
    },
    {
      "claim_id": "sql_no_prefix/Q1.5/004",
      "text": "Liquid flows through a narrow capillary under gravity; the flow time is proportional to kinematic viscosity. Combined with density, this yields dynamic viscosity. The Ubbelohde variant uses a suspended-level design that eliminates the need for a precise fill volume.",
      "line": 34,
      "category": "domain_knowledge",
      "incorrect": false,
      "reason": "Correct principle and practical instrument description.",
      "evidence": [
        "https://store.astm.org/d0445-21e01.html",
        "evidence/reference_domain_review.md; laminar-flow, force-balance and rotational-torque viscometry principles"
      ]
    },
    {
      "claim_id": "sql_no_prefix/Q1.5/005",
      "text": "| **Falling or rolling sphere (ball) viscometry** | ~26 |",
      "line": 35,
      "category": "database_verified",
      "incorrect": false,
      "reason": "Approximate study counts agree with 38,25,3;~26 adequately approximates 25 papers/26 blocks.",
      "evidence": [
        "N:\\_Code_Maintenance\\ThermoML_research_agent\\ThermoML.v2020-09-30.db\\thermoml_raw.db",
        "evidence/reference_findings.md; standard-method pure-ethanol counts: capillary38/38,sphere26/25,concentric3/3 blocks/papers"
      ]
    },
    {
      "claim_id": "sql_no_prefix/Q1.5/006",
      "text": "A sphere falls or rolls through the liquid in a calibrated tube; the terminal velocity is related to viscosity via Stokes' law (with corrections). Often implemented as the Anton Paar AMVn or Lovis instruments.",
      "line": 35,
      "category": "domain_knowledge",
      "incorrect": false,
      "reason": "Correct principle and practical instrument description.",
      "evidence": [
        "https://store.astm.org/d0445-21e01.html",
        "evidence/reference_domain_review.md; laminar-flow, force-balance and rotational-torque viscometry principles"
      ]
    },
    {
      "claim_id": "sql_no_prefix/Q1.5/007",
      "text": "| **Concentric cylinders (rotational) viscometry** | ~3 |",
      "line": 36,
      "category": "database_verified",
      "incorrect": false,
      "reason": "Approximate study counts agree with 38,25,3;~26 adequately approximates 25 papers/26 blocks.",
      "evidence": [
        "N:\\_Code_Maintenance\\ThermoML_research_agent\\ThermoML.v2020-09-30.db\\thermoml_raw.db",
        "evidence/reference_findings.md; standard-method pure-ethanol counts: capillary38/38,sphere26/25,concentric3/3 blocks/papers"
      ]
    },
    {
      "claim_id": "sql_no_prefix/Q1.5/008",
      "text": "The liquid fills the gap between two coaxial cylinders; one rotates and the torque (or angular velocity) is measured, giving shear stress and hence viscosity.",
