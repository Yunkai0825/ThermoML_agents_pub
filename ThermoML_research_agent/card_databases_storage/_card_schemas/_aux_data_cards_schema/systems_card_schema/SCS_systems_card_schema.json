{
  "$schema": "thermoml_systems_card_schema_v1",
  "$id": "SCS_systems_card_schema",
  "title": "ThermoML Systems Card Schema",
  "description": "One card per unique chemical system (unique sorted set of components). The discovery layer: agents query SCS to answer 'what data exists for water + ethanol?' before loading any PCS cards. Systems are defined by the Component list in each PureOrMixtureData block, deduplicated by SMILES across all papers.",
  "version": "1.0.0",
  "database_stats": {
    "note": "From full DB scan of 11,923 files / 122,481 PureOrMixtureData blocks / 2,690,357 data points",
    "unique_systems": 44630,
    "systems_with_multiple_papers": 7105,
    "systems_by_type": {
      "unary": 8502,
      "binary": 28982,
      "ternary": 7102
    },
    "blocks_by_type": {
      "unary": 45821,
      "binary": 58292,
      "ternary": 18324
    },
    "missing_inchikey_compounds": 61,
    "missing_inchikey_files": 57,
    "note_smiles": "SMILES are derived from InChI via RDKit canonical SMILES. The 61 compounds missing InChI/InChIKey will also lack SMILES.",
    "top_systems": [
      "NaCl + water (192 blocks, 125 papers)",
      "ethanol + water (126 blocks, 73 papers)",
      "KCl + water (124 blocks, 91 papers)",
      "glycine + water (124 blocks, 79 papers)",
      "D-glucose + water (94 blocks, 48 papers)"
    ]
  },
  "card_structure": {
    "identity": {
      "description": "Uniquely identifies this system. Primary key is sorted SMILES joined by '::' — a deterministic, canonical identifier derived from the component structures.",
      "fields": {
        "system_id": {
          "type": "string",
          "description": "Canonical system identifier. Sorted SMILES joined by '::'. Example: 'CCO::O' for ethanol + water. SMILES are canonical (RDKit-derived from InChI) to ensure deterministic deduplication."
        },
        "system_type": {
          "type": "string",
          "description": "Classification by number of components",
          "allowed_values": [
            "unary",
            "binary",
            "ternary",
            "quaternary+"
          ]
        },
        "n_components": {
          "type": "integer",
          "description": "Number of distinct compounds in this system (1, 2, 3, ...)"
        }
      }
    },
    "components": {
      "description": "Ordered list of compounds in this system. Sorted by SMILES for canonical ordering. Each entry references the global compound registry.",
      "type": "array",
      "items": {
        "fields": {
          "comp_num_id": {
            "type": "string",
            "description": "Global compound registry ID. Format: 'GLOBcomp_<positive integer>'."
          },
          "SMILES": {
            "type": "string",
            "description": "Canonical SMILES — derived from InChI via RDKit during card generation. Primary structural identifier and CDS lookup key."
          },
          "name": {
            "type": "string",
            "description": "Most common name across all papers studying this system (first sCommonName from highest-frequency paper)"
          },
          "formula": {
            "type": "string",
            "description": "Molecular formula (sFormulaMolec)"
          }
        }
      }
    },
    "data_coverage": {
      "description": "Precomputed summary of all data available for this system across all papers. This is the primary discovery section — agents read this to decide whether to load PCS cards.",
      "fields": {
        "n_papers": {
          "type": "integer",
          "description": "Number of distinct papers (DOIs) that studied this system"
        },
        "n_blocks": {
          "type": "integer",
          "description": "Total measurement blocks across all papers"
        },
        "n_datapoints": {
          "type": "integer",
          "description": "Total data points across all blocks"
        },
        "property_groups": {
          "type": "object",
          "description": "Map of PropertyGroup name -> number of property instances. Example: {'VolumetricProp': 42, 'TransportProp': 18}",
          "fields": {
            "<group_name>": {
              "type": "integer",
              "description": "Count of property instances in this group for this system"
            }
          }
        },
        "property_names": {
          "type": "array",
          "description": "All distinct property names (ePropName) measured for this system",
          "items": {
            "type": "string"
          }
        },
        "phases_observed": {
          "type": "array",
          "description": "All distinct phases (ePropPhase) observed across measurements",
          "items": {
            "type": "string"
          }
        },
        "temperature_range_K": {
          "type": "object|null",
          "description": "Min/max temperature across all data points and constraints",
          "fields": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "pressure_range_kPa": {
          "type": "object|null",
          "description": "Min/max pressure across all data points and constraints",
          "fields": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "papers": {
      "description": "Papers that studied this system, sorted by n_blocks descending (most data first). For heavily-studied systems (>20 papers), truncated to top 20; use n_papers in data_coverage for the true count.",
      "max_items_note": "Truncated to 20 when n_papers > 20 (affects 0.4% of systems). 84% of systems have exactly 1 paper; 99% have ≤10.",
      "type": "array",
      "items": {
        "fields": {
          "doi": {
            "type": "string",
            "description": "Paper DOI — key to RMS for full citation"
          },
          "n_blocks": {
            "type": "integer",
            "description": "Number of measurement blocks from this paper for this system"
          },
          "property_groups": {
            "type": "array",
            "description": "Which property groups this paper measured for this system",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "generation": {
    "note": "SCS cards are generated ON DEMAND per chemical system; no materialized SCS database exists. The two generator views are search_system_registry (block-level rows for a system filter) and search_system_summary (aggregate statistics + top_papers for a compound/property slice; at least one of compound/property is required, so a whole-database dump is impossible).",
    "generators": [
      "card_db_search_tools/basic_search_tools/2_system_registry_search.py",
      "card_db_search_tools/basic_search_tools/9_system_summary_search.py"
    ]
  },
