{
  "$schema": "thermoml_reference_metadata_schema_v1",
  "$id": "RMS_reference_metadata_schema",
  "title": "ThermoML Reference Metadata Card Schema",
  "description": "One card per paper (DOI). Holds all bibliographic metadata plus a precomputed content summary of what the paper contributes to the database. Agents load RMS when they need citation context, author info, or paper-level discovery. PCS cards carry only {doi, title} and reference RMS for the rest.",
  "version": "1.0.0",
  "database_stats": {
    "total_papers": 11726,
    "year_range": "2003-2019",
    "all_journal_type": true,
    "all_original_source": true,
    "with_abstract": 11682,
    "with_keywords": 7910,
    "unique_keywords": 13747
  },
  "card_structure": {
    "identity": {
      "description": "Primary key and internal identifiers",
      "fields": {
        "doi": {
          "type": "string",
          "description": "Digital Object Identifier (sDOI). Primary key for this card. 1 file in DB lacks sDOI — use filename-derived DOI as fallback."
        },
        "lit_id": {
          "type": "string",
          "description": "TRC literature identifier derived from TRCRefID (yrYrPub-sAuthor1-sAuthor2-nAuthorn). Unique per paper; 1:1 with DOI. Compact human-readable paper handle.",
          "example": "2007-shi-yok-2"
        },
        "trc_ref_id": {
          "type": "object",
          "description": "TRC-specific reference identifier (TRCRefID). Present in all 11,726 files.",
          "fields": {
            "year": {
              "type": "string",
              "description": "Publication year from TRC (yrYrPub)"
            },
            "author1": {
              "type": "string",
              "description": "First author abbreviation (sAuthor1, 3 chars)"
            },
            "author2": {
              "type": "string",
              "description": "Second author abbreviation (sAuthor2, 2-3 chars)"
            },
            "author_n": {
              "type": "string",
              "description": "Additional author count (nAuthorn)"
            }
          }
        },
        "lit_num_id": {
          "type": "string",
          "description": "[audited] Present in 100.0% of cards. Example: GLOBlit_1"
        }
      }
    },
    "bibliographic": {
      "description": "Full citation metadata. All fields present in 100% of papers unless noted.",
      "fields": {
        "title": {
          "type": "string",
          "description": "Paper title (sTitle). Median 119 chars, max 389."
        },
        "authors": {
          "type": "array",
          "description": "Author list (sAuthor). Format: 'LastName, I.[FirstName]'. Median 4 authors, max 15.",
          "items": {
            "type": "string"
          }
        },
        "journal": {
          "type": "string",
          "description": "Journal or publication name (sPubName). All entries are journals in this DB."
        },
        "year": {
          "type": "integer",
          "description": "Publication year (yrPubYr). Range: 2003–2019."
        },
        "volume": {
          "type": "string",
          "description": "Volume number (sVol). String to handle ranges like '228-229'."
        },
        "pages": {
          "type": "string",
          "description": "Page range (sPage, e.g., '79-86')."
        },
        "issue_number": {
          "type": "string|null",
          "description": "Issue number (sIDNum). Present in 65% of papers."
        },
        "publication_type": {
          "type": "string",
          "description": "Publication type (eType). All 11,726 are 'journal' in this DB.",
          "allowed_values": [
            "journal",
            "book",
            "thesis",
            "patent",
            "report",
            "conferenceProceedings",
            "personalCommunication",
            "unspecified"
          ]
        },
        "source_type": {
          "type": "string",
          "description": "Source type (eSourceType). All 11,726 are 'Original' in this DB.",
          "allowed_values": [
            "Original",
            "ChemicalAbstracts",
            "Other"
          ]
        },
        "citation_date": {
          "type": "string",
          "description": "Date the citation record was created/updated (dateCit, e.g., '2020-09-29')."
        }
      }
    },
    "content": {
      "description": "Textual content from the paper. Abstract present in 99.6%, keywords in 67%.",
      "fields": {
        "abstract": {
          "type": "string|null",
          "description": "Paper abstract (sAbstract). Median ~230 tokens, max ~940. Null for 44 papers."
        },
        "keywords": {
          "type": "array|null",
          "description": "Author keywords (sKeyword). Median 5, max 24. 13,747 unique keywords across DB. Null for 3,816 papers.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "data_inventory": {
      "description": "Precomputed summary of what experimental data this paper contributes. Agent reads this section for paper-level discovery without loading individual PCS cards.",
      "fields": {
        "n_compounds": {
          "type": "integer",
          "description": "Number of unique compounds in this paper. Median 4, max 94."
        },
        "compound_list": {
          "type": "array",
          "description": "Lightweight compound references for each compound. Enables compound-based paper discovery.",
          "items": {
            "type": "object",
            "fields": {
              "org_num": {
                "type": "string",
                "description": "DOI-scoped source component ID. Format: 'DOIcomp_<positive integer>'."
              },
              "comp_num_id": {
                "type": "string",
                "description": "Global compound registry ID. Format: 'GLOBcomp_<positive integer>'."
              },
              "inchi_key": {
                "type": "string",
                "description": "Canonical global compound structure key."
              },
              "SMILES": {
                "type": "string|null",
                "description": "Canonical SMILES — derived from InChI via RDKit. Primary structural identifier and CDS lookup key."
              },
              "InChI": {
                "type": "string|null",
                "description": "IUPAC Standard InChI — full canonical structure string from source data"
              },
              "name": {
                "type": "string",
                "description": "Primary common name"
              },
              "formula": {
                "type": "string",
                "description": "Molecular formula"
              }
            }
          }
        },
        "n_blocks": {
          "type": "integer",
          "description": "Total measurement blocks (PureOrMixtureData + ReactionData). Median 7, max 594."
        },
        "has_pure_or_mixture_data": {
          "type": "boolean",
          "description": "Whether the paper contains PureOrMixtureData blocks. True for 11,632 (99.2%)."
        },
        "has_reaction_data": {
          "type": "boolean",
          "description": "Whether the paper contains ReactionData blocks. True for 495 (4.2%)."
        },
        "property_names": {
          "type": "array",
          "description": "Distinct property names measured in this paper (from ePropName across all blocks).",
          "items": {
            "type": "string"
          }
        },
        "property_groups": {
          "type": "array",
          "description": "Distinct PropertyGroup classifications present.",
          "items": {
            "type": "string"
          }
        },
        "system_types": {
          "type": "array",
          "description": "System sizes present (e.g., ['unary', 'binary']).",
          "items": {
            "type": "string"
          }
        },
        "temperature_range_K": {
          "type": "object|null",
          "description": "Overall temperature range across all blocks.",
          "fields": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "pressure_range_kPa": {
          "type": "object|null",
          "description": "Overall pressure range across all blocks (null if no pressure data).",
          "fields": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "n_datapoints": {
          "type": "integer",
          "description": "Total data points across all blocks in this paper."
        },
        "properties": {
          "type": "array",
          "description": "[audited] Present in 100.0% of cards.",
          "items": {
            "fields": {
              "component_linked": {
                "type": "boolean",
                "description": "[audited] Present in 100.0% of cards. Example: False"
              },
              "name": {
                "type": "string",
                "description": "[audited] Present in 100.0% of cards. Example: Thermal conductivity, W/m/K"
              },
              "prop_id": {
                "type": "string",
                "description": "[audited] Present in 100.0% of cards. Example: thermal_conductivity_w_m_k"
              },
              "prop_num_id": {
                "type": "string",
                "description": "[audited] Present in 100.0% of cards. Example: GLOBprop_34"
              }
            }
          }
        }
      }
    }
  },
