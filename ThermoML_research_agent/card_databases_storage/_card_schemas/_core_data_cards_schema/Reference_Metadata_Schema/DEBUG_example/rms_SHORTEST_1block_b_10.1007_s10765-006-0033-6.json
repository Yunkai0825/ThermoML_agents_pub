    "title": "Burnett Measurements and Virial Coefficients for the R32+N2O System",
    "authors": [
      "Di Nicola, G.",
      "Giuliani, G.",
      "Polonara, F.",
      "Stryjek, R."
    ],
    "journal": "Int. J. Thermophys.",
